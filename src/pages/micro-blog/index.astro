---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import MicroblogPreview from "../../components/MicroblogPreview.astro";
import { getAllMicroblogs } from "../../utils/microblog";

const entries = await getAllMicroblogs();

---

<Base
  title="Micro-blog"
  description="Short-form notes and things learned"
>
  <div class="site-shell mx-auto px-6 py-12 md:py-20 topo-mask">
    <Header activeSection="micro-blog" compactSpacing />

    <div class="mb-4 h-px bg-[var(--border)] animate-fade-in stagger-2"></div>

    <section class="animate-fade-up stagger-2">
      {
        entries.length > 0 ? (
          <div class="space-y-1">
            {entries.map((entry, i) => (
              <MicroblogPreview
                title={entry.data.title}
                description={entry.data.description}
                publishDate={entry.data.publishDate}
                slug={entry.id}
                index={i}
              />
            ))}
          </div>
        ) : (
          <p class="font-serif text-sm text-[var(--text-muted)] italic">
            No micro-blog entries yet. Check back soon.
          </p>
        )
      }
    </section>

    <div class="mt-10">
      <Footer />
    </div>
  </div>
</Base>
