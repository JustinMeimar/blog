---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectEmoji from "../../components/ProjectEmoji.astro";
import { Image } from "astro:assets";
import { getAllProjects, formatAwards } from "../../utils/projects";

const projects = await getAllProjects();
---

<Base title="Projects | justinmeimar — Justin Meimar" description="Projects and open source work by Justin Meimar. Compilers, systems programming, and developer tools.">
  <div class="max-w-2xl mx-auto px-6 py-12 md:py-20 topo-mask">
    <Header activeSection="projects" compactSpacing />

    <!-- Divider -->
    <div class="mb-4 h-px bg-[var(--border)] animate-fade-in stagger-2"></div>

    <section class="animate-fade-up stagger-2">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {projects.map((project, i) => (
          <article class:list={[
            "flex flex-col rounded border border-[var(--border)] p-4 transition-colors duration-300 hover:bg-[var(--bg-paper)] animate-fade-up",
            `stagger-${Math.min(i + 3, 6)}`,
          ]}>
            <div class="flex items-baseline justify-between gap-3 mb-2">
              <h2 class="font-serif text-base leading-6">
                <a href={`/projects/${project.id}`} class="hover:underline decoration-1 underline-offset-4 decoration-[var(--link-color)]">
                  {project.data.emoji && <ProjectEmoji emoji={project.data.emoji} />}
                  {project.data.name}
                </a>
              </h2>
              {project.data.links.github && (
                <a href={project.data.links.github} target="_blank" rel="noopener noreferrer"
                  aria-label={`${project.data.name} on GitHub`}
                  class="shrink-0 font-mono text-[10px] text-[var(--text-muted)] hover:text-[var(--text)] hover:underline underline-offset-4">
                  GitHub ↗
                </a>
              )}
            </div>

            {project.data.description && (
              <p class="font-serif text-[13px] leading-5 text-[var(--text-muted)]">
                {project.data.description}
              </p>
            )}

            {project.data.awards.length > 0 && (
              <p class="font-mono text-[10px] text-[var(--text-muted)] mt-2">
                {formatAwards(project.data.awards)}
              </p>
            )}

            {project.data.coverImage && (
              <a href={`/projects/${project.id}`} class="block mt-3">
                <Image src={project.data.coverImage.src} alt={project.data.coverImage.alt}
                  class="w-full h-auto rounded" widths={[400, 800]}
                  sizes="(max-width: 639px) 100vw, 300px" />
              </a>
            )}

            <div class="mt-auto pt-4 flex items-end justify-between gap-3 font-mono text-[10px] leading-4 text-[var(--text-faint)]">
              <div class="flex flex-wrap gap-x-2 gap-y-1">
                {project.data.tags.slice(0, 5).map((tag) => <span>{tag}</span>)}
              </div>
              <span class="shrink-0 tabular-nums">{project.data.year}</span>
            </div>

            {(project.data.links.demo || project.data.links.docs) && (
              <div class="flex gap-3 mt-2 font-mono text-[11px] text-[var(--text-muted)]">
                {project.data.links.demo && (
                  <a href={project.data.links.demo} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4">Demo ↗</a>
                )}
                {project.data.links.docs && (
                  <a href={project.data.links.docs} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4">Docs ↗</a>
                )}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <div class="mt-10">
      <Footer />
      <p class="mt-3 font-mono text-[10px] text-[var(--text-faint)]">
        Icons by <a href="https://openmoji.org/" class="hover:underline underline-offset-4">OpenMoji</a>,
        <a href="https://creativecommons.org/licenses/by-sa/4.0/" class="hover:underline underline-offset-4">CC BY-SA 4.0</a>.
      </p>
    </div>
  </div>
</Base>
