---
/**
 * BlogImage - Enhanced image component for blog posts
 *
 * Usage examples:
 *
 * Basic image:
 * <BlogImage src="/images/jitless_part1/diagram.svg" alt="Architecture diagram" />
 *
 * Float right with text wrapping:
 * <BlogImage src="/images/jitless_part1/photo.png" alt="Photo" float="right" />
 *
 * Dark mode - invert colors:
 * <BlogImage src="/images/chart.svg" alt="Chart" darkMode="invert" />
 *
 * Dark mode - show border:
 * <BlogImage src="/images/diagram.png" alt="Diagram" darkMode="border" />
 *
 * Dark mode - separate images:
 * <BlogImage
 *   src="/images/light-diagram.svg"
 *   darkSrc="/images/dark-diagram.svg"
 *   alt="Diagram"
 * />
 *
 * With caption:
 * <BlogImage
 *   src="/images/example.png"
 *   alt="Example"
 *   caption="Figure 1: The example"
 * />
 *
 * Size variants:
 * <BlogImage src="/images/small.png" alt="Small" size="small" />
 * <BlogImage src="/images/medium.png" alt="Medium" size="medium" />
 */

interface Props {
  src: string;
  alt: string;
  darkSrc?: string;
  caption?: string;
  float?: 'left' | 'right';
  darkMode?: 'invert' | 'border';
  size?: 'small' | 'medium' | 'full';
  class?: string;
  /** Set false to disable the enlargement control. */
  zoomable?: boolean;
}

const {
  src,
  alt,
  darkSrc,
  caption,
  float,
  darkMode,
  size,
  class: className = '',
  zoomable = true
} = Astro.props;

const floatClass = float ? `float-${float}` : '';
const sizeClass = size ? `img-${size}` : '';
const baseClasses = [floatClass, sizeClass, className].filter(Boolean).join(' ');
---

<figure class={baseClasses} data-image-lightbox={zoomable ? "" : undefined}>
  <div data-image-lightbox-media>
    <img src={src} alt={alt} data-theme={darkSrc ? "light-only" : undefined} data-theme-adapt={darkMode} />
    {darkSrc && <img src={darkSrc} alt={alt} data-theme="dark-only" />}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import { initImageLightboxes } from '../lib/imageLightbox';

  let cleanup: (() => void) | undefined;
  function init() {
    cleanup?.();
    cleanup = initImageLightboxes();
  }
  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style>
  /* Keep the existing article image sizing inside the control wrapper. */
  figure.img-full img { width: 100%; max-width: 100%; }
</style>
