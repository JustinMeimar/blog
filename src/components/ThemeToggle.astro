<button
  id="theme-toggle"
  type="button"
  class="header-control p-2 rounded bg-[var(--bg-paper)]"
  aria-label="Toggle light or dark mode"
>
  <img class="theme-moon" src="/icons/openmoji/1F319.svg" width="16" height="16" alt="" aria-hidden="true" />
  <img class="theme-sun" src="/icons/openmoji/2600.svg" width="16" height="16" alt="" aria-hidden="true" />
</button>

<style>
  img { width: 1rem; height: 1rem; }
  .theme-sun { display: none; }
  :global([data-theme="dark"]) .theme-moon { display: none; }
  :global([data-theme="dark"]) .theme-sun { display: block; filter: invert(1); }
</style>

<script>
  function initThemeToggle() {
    const button = document.getElementById('theme-toggle');
    if (!button) return;
    function updateLabel() {
      button?.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} mode`);
    }
    updateLabel();
    // Assignment remains idempotent through Astro navigation and HMR.
    button.onclick = () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      updateLabel();
      window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: next } }));
    };
  }
  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
