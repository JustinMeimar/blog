<canvas id="topo-bg" aria-hidden="true"></canvas>

<style>
  #topo-bg {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  function initTopoBg() {
    const canvas = document.getElementById("topo-bg") as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    // Pick a landscape once per page; redraws keep the same terrain.
    const seed = crypto.getRandomValues(new Uint32Array(1))[0];
    let w = 0;
    let h = 0;
    let cols = 0;
    let rows = 0;
    let heights = new Float32Array(0);
    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(w / 12);
      rows = Math.ceil(h / 12);
      heights = new Float32Array((cols + 1) * (rows + 1));
      render();
    }

    // Smooth seeded value noise: broad landforms with smaller, irregular detail.
    function hash(x: number, y: number): number {
      let n = (Math.imul(x, 374761393) + Math.imul(y, 668265263)) ^ seed;
      n = Math.imul(n ^ (n >>> 13), 1274126177);
      return ((n ^ (n >>> 16)) >>> 0) / 4294967295;
    }

    function noise(x: number, y: number): number {
      const ix = Math.floor(x);
      const iy = Math.floor(y);
      const fx = x - ix;
      const fy = y - iy;
      const u = fx * fx * fx * (fx * (fx * 6 - 15) + 10);
      const v = fy * fy * fy * (fy * (fy * 6 - 15) + 10);
      const a = hash(ix, iy);
      const b = hash(ix + 1, iy);
      const c = hash(ix, iy + 1);
      const d = hash(ix + 1, iy + 1);
      return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
    }

    function terrain(x: number, y: number): number {
      // Use the same scale in both axes so mountains keep their shape on phones.
      const scale = Math.max(w, h, 800);
      let nx = x / scale * 5 + 13.4;
      let ny = y / scale * 5 + 7.8;
      const warpX = noise(nx * 0.7, ny * 0.7);
      const warpY = noise(nx * 0.7 + 31, ny * 0.7 + 17);
      nx += (warpX - 0.5) * 1.4;
      ny += (warpY - 0.5) * 1.4;
      const broad = noise(nx, ny);
      const detail = noise(nx * 2.1 + 19, ny * 2.1 + 43);
      const fine = noise(nx * 4.3 + 51, ny * 4.3 + 11);
      const ridge = 1 - Math.abs(noise(nx * 1.2 + 71, ny * 1.2 + 29) * 2 - 1);
      return broad * 0.57 + detail * 0.23 + fine * 0.08 + ridge * 0.12;
    }

    function render() {
      ctx!.clearRect(0, 0, w, h);
      const dark = document.documentElement.getAttribute("data-theme") === "dark";
      const color = dark ? "65, 155, 170" : "35, 131, 75";
      const cellW = w / cols;
      const cellH = h / rows;
      const stride = cols + 1;
      // Sample each point once, then reuse it for every contour elevation.
      for (let row = 0; row <= rows; row++) {
        for (let col = 0; col <= cols; col++) {
          heights[row * stride + col] = terrain(col * cellW, row * cellH);
        }
      }
      ctx!.lineCap = "round";
      ctx!.lineJoin = "round";
      for (let level = 1; level < 24; level++) {
        const threshold = level / 24;
        const major = level % 4 === 0;
        const alpha = dark ? (major ? 0.46 : 0.23) : (major ? 0.32 : 0.17);
        ctx!.beginPath();
        ctx!.strokeStyle = `rgba(${color}, ${alpha})`;
        ctx!.lineWidth = major ? 1.25 : 0.65;
        for (let row = 0; row < rows; row++) {
          for (let col = 0; col < cols; col++) {
            const i = row * stride + col;
            marchCell(ctx!, col * cellW, row * cellH, cellW, cellH,
              heights[i], heights[i + 1], heights[i + stride], heights[i + stride + 1], threshold);
          }
        }
        // A very faint wider stroke gives the index contours a little ink depth.
        if (major) {
          ctx!.save();
          ctx!.strokeStyle = `rgba(${color}, ${dark ? 0.035 : 0.025})`;
          ctx!.lineWidth = 5;
          ctx!.stroke();
          ctx!.restore();
        }
        ctx!.stroke();
      }
    }

    function marchCell(
      c: CanvasRenderingContext2D,
      x: number, y: number,
      cw: number, ch: number,
      v00: number, v10: number, v01: number, v11: number,
      thr: number
    ) {
      const idx =
        (v00 > thr ? 8 : 0) |
        (v10 > thr ? 4 : 0) |
        (v11 > thr ? 2 : 0) |
        (v01 > thr ? 1 : 0);

      if (idx === 0 || idx === 15) return;

      const lerp = (a: number, b: number, va: number, vb: number) => {
        const d = vb - va;
        return d === 0 ? a : a + ((thr - va) / d) * (b - a);
      };

      const top = lerp(x, x + cw, v00, v10);
      const bottom = lerp(x, x + cw, v01, v11);
      const left = lerp(y, y + ch, v00, v01);
      const right = lerp(y, y + ch, v10, v11);

      const line = (x1: number, y1: number, x2: number, y2: number) => {
        c.moveTo(x1, y1);
        c.lineTo(x2, y2);
      };

      switch (idx) {
        case 1: case 14: line(x, left, bottom, y + ch); break;
        case 2: case 13: line(bottom, y + ch, x + cw, right); break;
        case 3: case 12: line(x, left, x + cw, right); break;
        case 4: case 11: line(top, y, x + cw, right); break;
        case 5:
          if ((v00 + v10 + v01 + v11) / 4 > thr) {
            line(x, left, top, y);
            line(bottom, y + ch, x + cw, right);
          } else {
            line(x, left, bottom, y + ch);
            line(top, y, x + cw, right);
          }
          break;
        case 6: case 9: line(top, y, bottom, y + ch); break;
        case 7: case 8: line(x, left, top, y); break;
        case 10:
          if ((v00 + v10 + v01 + v11) / 4 > thr) {
            line(x, left, bottom, y + ch);
            line(top, y, x + cw, right);
          } else {
            line(x, left, top, y);
            line(bottom, y + ch, x + cw, right);
          }
          break;
      }
    }

    resize();
    window.addEventListener("resize", resize);
    window.addEventListener("theme-changed", render);
    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("resize", resize);
      window.removeEventListener("theme-changed", render);
    }, { once: true });
  }

  initTopoBg();
  document.addEventListener("astro:after-swap", initTopoBg);
</script>
