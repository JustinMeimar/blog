---
import { formatDate } from "../utils/microblog";

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  slug: string;
  index?: number;
}

const { title, description, publishDate, slug, index = 0 } = Astro.props;
---

<article
  class:list={[
    "group animate-fade-up",
    `stagger-${Math.min(index + 3, 6)}`,
  ]}
>
  <a href={`/micro-blog/${slug}`} class="block rounded px-4 py-2 -mx-4 hover:bg-[var(--bg-paper)] transition-colors duration-300">
    <div class="flex items-baseline justify-between gap-4">
      <h3
        class="min-w-0 font-serif text-[15px] leading-5 group-hover:underline decoration-1 underline-offset-4 decoration-[var(--link-color)]"
      >
        {title}
      </h3>
      <time datetime={publishDate.toISOString()} class="shrink-0 font-mono text-[11px] leading-4 text-[var(--text-faint)] tabular-nums">
        {formatDate(publishDate)}
      </time>
    </div>
    {description && (
      <p class="font-serif text-[13px] leading-5 text-[var(--text-muted)] mt-0.5">
        {description}
      </p>
    )}
  </a>
</article>
