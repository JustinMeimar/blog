---
import { formatDate } from "../utils/posts";

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  slug: string;
  readingTime?: string;
  index?: number;
  compact?: boolean;
  listLayout?: boolean;
}

const { title, description, publishDate, slug, readingTime, index = 0, compact = false, listLayout = false } = Astro.props;
---

<article
  class:list={[
    "group cursor-pointer px-4 -mx-4 rounded transition-colors duration-300",
    !listLayout && "hover-lift",
    compact || listLayout ? "py-2" : "py-4",
    "hover:bg-[var(--bg-paper)]",
    "animate-fade-up",
    `stagger-${Math.min(index + 3, 6)}`,
  ]}
>
  <a href={`/posts/${slug}`} class="block">
    {listLayout ? (
      <>
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="min-w-0 font-serif text-[15px] leading-5 group-hover:underline decoration-1 underline-offset-4 decoration-[var(--link-color)]">
            {title}
          </h3>
          <time datetime={publishDate.toISOString()} class="shrink-0 font-mono text-[11px] leading-4 text-[var(--text-faint)] tabular-nums">
            {formatDate(publishDate)}
          </time>
        </div>
        <div class="flex items-baseline justify-between gap-4 mt-0.5">
          <p class="min-w-0 font-serif text-[13px] leading-5 text-[var(--text-muted)]">
            {description}
          </p>
          {readingTime && (
            <span class="shrink-0 font-mono text-[11px] leading-4 text-[var(--text-faint)] tabular-nums">
              {readingTime}
            </span>
          )}
        </div>
      </>
    ) : (
      <>
    <div class="flex items-baseline gap-4 mb-2">
      <time class="font-mono text-xs text-[var(--text-muted)]">
        {formatDate(publishDate)}
      </time>
      <span class="font-mono text-xs text-[var(--text-faint)]">·</span>
      <span class="font-mono text-xs text-[var(--text-muted)]">
        {readingTime}
      </span>
    </div>
    <h3
      class="font-serif text-lg mb-2 group-hover:underline decoration-1 underline-offset-4 decoration-[var(--link-color)]"
    >
      {title}
    </h3>
    <p class="font-serif text-sm text-stone-500">
      {description}
    </p>
      </>
    )}
  </a>
</article>
