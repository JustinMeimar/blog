---
interface Props {
  emoji: string;
}

const { emoji } = Astro.props;
const code = Array.from(emoji)
  .map((character) => character.codePointAt(0)!.toString(16).toUpperCase())
  .join("-");
// Version-pinned OpenMoji black artwork, CC BY-SA 4.0.
const src = `/icons/openmoji/${code}.svg`;
---

<img src={src} alt="" aria-hidden="true" width="24" height="24" class="project-emoji" />

<style>
  .project-emoji {
    display: inline-block;
    width: 1.5rem;
    height: 1.5rem;
    margin-right: 0.35rem;
    vertical-align: -0.35rem;
    opacity: 0.7;
  }

  :global([data-theme="dark"]) .project-emoji {
    filter: invert(1);
    opacity: 0.85;
  }
</style>
